# development | production
AUDITAI_ENV=development

# Required in production: generate at least 32 random characters
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local development database
DATABASE_URL=sqlite:///auditai.db

# Production example (placeholder only; never commit real credentials):
# DATABASE_URL=postgresql://auditai:replace-me@db.example.invalid:5432/auditai
# COOKIE_SECURE=true

# Optional: initial administrator bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_USERNAME=admin

# Optional: set to true only for local debugging
FLASK_DEBUG=false

# Production request protections
COOKIE_SECURE=true
MAX_REQUEST_BYTES=10485760
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
